<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence untuk auto-generate nomor tiket: TKT/2026/0001 -->
    <record id="seq_bureaucracy_ticket" model="ir.sequence">
        <field name="name">Bureaucracy Ticket Sequence</field>
        <field name="code">bureaucracy.ticket</field>
        <field name="prefix">TKT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

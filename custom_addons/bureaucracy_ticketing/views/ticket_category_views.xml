<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- FORM VIEW - Category -->
    <!-- ============================================ -->
    <record id="view_ticket_category_form" model="ir.ui.view">
        <field name="name">bureaucracy.ticket.category.form</field>
        <field name="model">bureaucracy.ticket.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Tiket">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nama Kategori..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="ticket_count"/>
                        </group>
                    </group>
                    <group string="Deskripsi">
                        <field name="description" nolabel="1"
                               placeholder="Penjelasan kategori ini..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- LIST VIEW - Category -->
    <!-- ============================================ -->
    <record id="view_ticket_category_list" model="ir.ui.view">
        <field name="name">bureaucracy.ticket.category.list</field>
        <field name="model">bureaucracy.ticket.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Tiket" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="ticket_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- ACTION - Category -->
    <!-- ============================================ -->
    <record id="action_ticket_category" model="ir.actions.act_window">
        <field name="name">Kategori Tiket</field>
        <field name="res_model">bureaucracy.ticket.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Kategori Tiket Baru
            </p>
            <p>
                Kategori digunakan untuk mengklasifikasikan jenis kerusakan
                yang dilaporkan.
            </p>
        </field>
    </record>

</odoo>

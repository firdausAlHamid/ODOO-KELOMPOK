<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- FORM VIEW - Comment -->
    <!-- ============================================ -->
    <record id="view_ticket_comment_form" model="ir.ui.view">
        <field name="name">bureaucracy.ticket.comment.form</field>
        <field name="model">bureaucracy.ticket.comment</field>
        <field name="arch" type="xml">
            <form string="Komentar Tiket">
                <sheet>
                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="author_id"/>
                            <field name="comment_type"/>
                        </group>
                    </group>
                    <group string="Isi Komentar">
                        <field name="body" nolabel="1"
                               placeholder="Tulis komentar atau update progress..."/>
                    </group>
                    <group string="Lampiran">
                        <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- LIST VIEW - Comment -->
    <!-- ============================================ -->
    <record id="view_ticket_comment_list" model="ir.ui.view">
        <field name="name">bureaucracy.ticket.comment.list</field>
        <field name="model">bureaucracy.ticket.comment</field>
        <field name="arch" type="xml">
            <list string="Log Penanganan">
                <field name="create_date" string="Waktu"/>
                <field name="ticket_id"/>
                <field name="author_id"/>
                <field name="comment_type"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- ACTION - Comment -->
    <!-- ============================================ -->
    <record id="action_ticket_comment_list" model="ir.actions.act_window">
        <field name="name">Log Penanganan</field>
        <field name="res_model">bureaucracy.ticket.comment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
